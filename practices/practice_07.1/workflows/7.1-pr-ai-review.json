    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "\n// unified diff -> блоки файлов с номерами строк в новой версии\nconst raw = $input.first().json.data || '';\nconst lines = String(raw).split('\\n');\nconst files = [];\nlet cur = null, file = null, oldNo = 0, newNo = 0;\n\nfor (const line of lines) {\n  if (line.startsWith('diff --git ')) {\n    const m = line.match(/^diff --git a\\/(.+?) b\\/(.+)$/);\n    file = m ? m[2] : null; cur = null; continue;\n  }\n  if (line.startsWith('@@')) {\n    const m = line.match(/^@@ -(\\d+)(?:,\\d+)? \\+(\\d+)(?:,\\d+)? @@/);\n    if (!m || !file) continue;\n    oldNo = parseInt(m[1], 10); newNo = parseInt(m[2], 10);\n    cur = { file, block: files.filter(f => f.file === file).length + 1, start: newNo, lines: [] };\n    files.push(cur); continue;\n  }\n  if (!cur) continue;\n  if (line.startsWith('+') && !line.startsWith('+++')) {\n    cur.lines.push({ n: newNo, t: '+', text: line.slice(1) }); newNo++;\n  } else if (line.startsWith('-') && !line.startsWith('---')) {\n    oldNo++;\n  } else {\n    cur.lines.push({ n: newNo, t: ' ', text: line.slice(1) }); newNo++; oldNo++;\n  }\n}\n\nconst blocks = [];\nfor (const f of files) {\n  if (!f.lines.length) continue;\n  const added = f.lines.filter(l => l.t === '+');\n  if (!added.length) continue;\n  blocks.push({ path: f.file, block: f.block, start_line: f.start,\n    added_lines: added.map(l => l.n),\n    code: f.lines.map(l => `${l.n}|${l.t}${l.text}`).join('\\n') });\n}\n\nconst budget = 60000;\nlet used = 0; const kept = [];\nfor (const b of blocks) {\n  if (used + b.code.length > budget) break;\n  used += b.code.length; kept.push(b);\n}\n\n// готовый текст для промпта — собираем здесь, чтобы не городить выражения в ноде промпта\nconst diffText = kept.map(b =>\n  `### ${b.path} (блок ${b.block}, добавленные строки: ${b.added_lines.join(', ')})\\n${b.code}`\n).join('\\n\\n');\n\nconst p = $('Parse Event').first().json;\nreturn [{ json: {\n  repo: p.repo, pr: p.pr, model: p.model, command: p.command, pr_key: p.pr_key,\n  sha: $('Get PR Meta').first().json.head.sha,\n  title: $('Get PR Meta').first().json.title,\n  body: ($('Get PR Meta').first().json.body || '').slice(0, 4000),\n  blocks: kept, diff_text: diffText, diff_truncated: kept.length < blocks.length,\n}}];\n"
      },
