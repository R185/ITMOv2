    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "\nconst h = $json.headers || {};\nconst ev = String(h['x-github-event'] || h['X-GitHub-Event'] || '');\nconst body = $json.body || $json;\nconst out = [];\n\nif (ev === 'pull_request' && body.action === 'opened') {\n  const pr = body.pull_request;\n  out.push({ command: 'pr_opened', model: 'main',\n    repo: body.repository.full_name, pr: pr.number, sha: pr.head.sha,\n    title: pr.title, author: pr.user.login });\n}\n\nif (ev === 'issue_comment' && body.action === 'created' && body.issue && body.issue.pull_request) {\n  const text = String(body.comment.body || '').trim();\n  const base = { repo: body.repository.full_name, pr: body.issue.number,\n    title: body.issue.title, author: body.comment.user.login, sha: null };\n  if (text.startsWith('/make_other_ai_review')) {\n    out.push({ ...base, command: 'make_other_ai_review', model: 'other' });\n  } else if (text.startsWith('/make_ai_review')) {\n    out.push({ ...base, command: 'make_ai_review', model: 'main' });\n  }\n}\n\nfor (const o of out) o.pr_key = o.repo + '#' + o.pr;\nif (!out.length) return [{ json: { skip: true } }];\nreturn out.map((o) => ({ json: o }));\n"
      },
