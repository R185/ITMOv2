    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "\nconst src = $('Split Diff into Blocks').first().json;\nconst raw = String($input.first().json.text || $input.first().json.output || '').trim();\nconst clean = raw.replace(/^```(?:json)?/i, '').replace(/```$/, '').trim();\n\nlet parsed;\ntry {\n  const s = clean.indexOf('{'), e = clean.lastIndexOf('}');\n  parsed = JSON.parse(clean.slice(s, e + 1));\n} catch (err) {\n  parsed = { summary: clean.slice(0, 2000), comments: [] };\n}\n\nconst byPath = {};\nfor (const b of src.blocks) {\n  if (!byPath[b.path]) byPath[b.path] = [];\n  byPath[b.path].push(...b.added_lines);\n}\n\nconst modelName = src.model === 'main' ? 'deepseek-flash' : 'deepseek-v4-pro';\nconst out = [], seen = new Set();\nfor (const c of (parsed.comments || [])) {\n  const lines = byPath[c.path];\n  if (!lines || !lines.length) continue;\n  let line = Number(c.line);\n  if (!Number.isFinite(line)) line = lines[0];\n  if (!lines.includes(line)) line = lines.reduce((a, b) => Math.abs(b - line) < Math.abs(a - line) ? b : a, lines[0]);\n  const key = c.path + ':' + line;\n  if (seen.has(key)) continue;\n  seen.add(key);\n  const icon = c.severity === 'major' ? '🔴' : c.severity === 'minor' ? '🟡' : '⚪';\n  out.push({ json: {\n    repo: src.repo, pr: src.pr, pr_key: src.pr_key, model: src.model, sha: src.sha,\n    summary: parsed.summary || '',\n    comment: { path: c.path, line, side: 'RIGHT',\n      body: `${icon} **${c.severity || 'note'}** — ${c.body}\\n\\n_AI review (${modelName})_` } } });\n}\n\nif (!out.length) {\n  out.push({ json: { repo: src.repo, pr: src.pr, pr_key: src.pr_key, model: src.model,\n    sha: src.sha, summary: parsed.summary || 'Изменения без замечаний.', comment: null } });\n}\nreturn out;\n"
      },
