      "id": "0ca0ea38-c2d6-4b90-940c-c6a99f6851f0",
      "name": "LLM: deepseek-v4-pro (second)",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "position": [
        1770,
        960
      ],
      "typeVersion": 1.3,
      "credentials": {
        "openAiApi": {
