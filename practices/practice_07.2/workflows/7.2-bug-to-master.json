    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const b = $input.first().json.body || $input.first().json;\nconst issue = b.issue || {};\nconst labels = (issue.labels || []).map(l => String(l.name || l).toLowerCase());\nconst action = String(b.action || '');\nif (!issue.number || !['opened', 'labeled'].includes(action) || !labels.includes('bug')) {\n  return [];\n}\nconst repo = (b.repository && b.repository.full_name) || 'R185/itmo-ai-practice-07';\nreturn [{ json: {\n  repo, issue: issue.number,\n  title: String(issue.title || '').slice(0, 300),\n  body: String(issue.body || '').slice(0, 4000),\n  author: (issue.user && issue.user.login) || 'unknown',\n  branch: 'fix/issue-' + issue.number,\n  path: 'src/calc.py',\n}}];"
      },
      "id": "51163a29-9a68-4e92-bce8-fb2b78241889",
      "name": "Parse Issue",
      "type": "n8n-nodes-base.code",
