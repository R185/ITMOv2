    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const out = $input.first().json;\nconst p = $('Build Prompt').first().json;\nlet code = String(out.text || out.output || '').trim();\nconst fenced = code.match(/```(?:python)?\\s*([\\s\\S]*?)```/);\nif (fenced) code = fenced[1].trim();\nconst looksLikeCode = /def\\s+\\w+\\s*\\(/.test(code) && !code.startsWith('{') && code.length > 100;\nconst changed = looksLikeCode && code !== String(p.code || '').trim();\nif (looksLikeCode && !code.endsWith('\\n')) code += '\\n';\nreturn [{ json: { ...p, new_content: looksLikeCode ? code : '',\n  content_b64: looksLikeCode ? Buffer.from(code, 'utf8').toString('base64') : '',\n  valid: looksLikeCode && changed, changed,\n  reason: !looksLikeCode ? 'модель вернула не код (' + code.length + ' симв.)' : (changed ? 'ok' : 'код не изменился') } }];"
      },
