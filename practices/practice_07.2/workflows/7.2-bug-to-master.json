    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const it = $input.first().json;\nconst src = Buffer.from(String(it.content || '').replace(/\\n/g, ''), 'base64').toString('utf8');\nconst prev = $('Parse Issue').first().json;\nreturn [{ json: { ...prev, code: src, file_sha: it.sha, size: src.length } }];"
      },
