        "jsCode": "const comments = $('Get PR Comments').all().map(i => i.json);\nconst checks = $input.first().json;\nconst reviews = $('Get Reviews').all().map(i => i.json);\nconst p = $('Use Patch').first().json;\nconst pr = $('Open PR').first().json;\n\nconst list = comments.filter(c => c && (c.body || c.path));\nconst meaningful = reviews.filter(r => String(r.body || '').trim().length > 0).length;\nconst major = list.filter(c => /🔴|\\bmajor\\b|blocker/i.test(String(c.body || ''))).length;\nconst runs = (checks.check_runs || []);\nconst states = runs.map(r => r.conclusion || r.status);\nconst anyFail = states.some(s => ['failure', 'cancelled', 'timed_out', 'action_required'].includes(s));\nconst allOk = runs.length > 0 && states.every(s => s === 'success');\n\nconst attempt = ($runIndex || 0) + 1;\n\nlet decision = 'revise', reason = '';\nif (meaningful === 0 && attempt < 6) { decision = 'wait'; reason = 'AI-ревью ещё не опубликовано, попытка ' + attempt; }\nelse if (allOk && major === 0) { decision = 'merge'; reason = 'тесты зелёные (' + runs.length + '), серьёзных замечаний нет'; }\nelse if (allOk && major > 0) { decision = 'arbitrate'; reason = 'ревьюер нашёл ' + major + ' major, нужен арбитраж'; }\nelse if (anyFail) { reason = 'тесты упали: ' + states.join(', '); }\nelse if (!runs.length || states.some(s => ['queued', 'in_progress', 'waiting'].includes(s))) {\n  if (attempt < 6) { decision = 'wait'; reason = 'CI ещё идёт, попытка ' + attempt; }\n  else { reason = 'CI не ответил за 6 попыток'; }\n}\nelse if (major > 0) { reason = 'AI-ревью: ' + major + ' серьёзных замечаний'; }\nelse { reason = 'условия мержа не выполнены'; }\n\nreturn [{ json: { repo: p.repo, issue: p.issue, pr: pr.number, branch: p.branch,\n  major, reviews: meaningful, runs: runs.length, states, decision, reason, attempt } }];"
      },
