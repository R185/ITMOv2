        "jsCode": "const it = $input.first().json;\nconst tests = Buffer.from(String(it.content || '').replace(/\\n/g, ''), 'base64').toString('utf8');\nconst p = $('Extract File').first().json;\nreturn [{ json: { ...p, tests } }];"
