    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const p = $('Extract Tests').first().json;\nconst ref = $input.first().json;\nconst prompt = [\n  'Почини баг в Python-модуле. Верни ТОЛЬКО полный текст файла, без markdown-обёрток и пояснений.',\n  '',\n  'issue #' + p.issue + ': ' + p.title,\n  'описание:', p.body || '(пусто)',\n  '',\n  'файл ' + p.path + ' (текущее содержимое):',\n  p.code,\n  '',\n  'тесты, которые должны проходить:',\n  p.tests,\n  '',\n  'Требования: минимальное изменение, публичный API не ломать, старые тесты не сломать.'\n].join('\\n');\nreturn [{ json: { ...p, main_sha: (ref.object && ref.object.sha) || '', prompt } }];"
      },
      "id": "185acb7d-d1dd-4e81-9d27-09c17cdaea4c",
