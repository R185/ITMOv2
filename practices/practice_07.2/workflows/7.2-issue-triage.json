    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "\nconst h = $json.headers || {};\nconst ev = String(h['x-github-event'] || h['X-GitHub-Event'] || '');\nconst body = $json.body || $json;\n\nif (ev !== 'issues' || body.action !== 'opened') return [{ json: { skip: true } }];\n\nconst i = body.issue;\nreturn [{ json: {\n  skip: false,\n  repo: body.repository.full_name,\n  number: i.number,\n  title: i.title,\n  body: i.body || '',\n  author: i.user.login,\n  author_association: i.author_association || 'NONE',\n  issue_url: i.html_url,\n} }];\n"
      },
