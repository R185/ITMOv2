    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "\nconst src = $('Parse Issue').first().json;\nconst c = $input.first().json;\nconst allowed = ['bug', 'task', 'feature'];\nconst type = allowed.includes(c.type) ? c.type : 'unknown';\nconst confidence = Number(c.confidence || 0);\nconst needsTriage = type === 'unknown' || confidence < 0.8;\nconst label = needsTriage ? 'needs-triage' : type;\n\nreturn [{ json: {\n  ...src,\n  type, confidence,\n  needs_triage: needsTriage,\n  label,\n  labels_url: `https://api.github.com/repos/${src.repo}/issues/${src.number}/labels`,\n  comment_url: `https://api.github.com/repos/${src.repo}/issues/${src.number}/comments`,\n} }];\n"
      },
