    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "\nconst cur = $('Group Stats').first().json;\nconst rows = $input.all().map(i => i.json).filter(r => r && r.week_start && r.week_start !== cur.week_start);\nconst prevRow = rows[0];\n\nlet prev = null;\nif (prevRow) {\n  try { prev = { week_start: prevRow.week_start, total: Number(prevRow.total || 0),\n                 by_type: JSON.parse(prevRow.by_type || '{}') }; } catch (e) { prev = null; }\n}\n\nconst dTotal = prev ? cur.total_created - prev.total : null;\n\n// запасной вариант: если в таблице ещё нет прошлой недели — берём нули и честно помечаем\nconst source = prev ? 'Data Table (weekly_stats)' : 'нет прошлой недели в Data Table';\nconst prevTypes = prev ? prev.by_type : {};\nconst dType = {};\nfor (const t of Object.keys(cur.by_type)) dType[t] = (cur.by_type[t] || 0) - (Number(prevTypes[t]) || 0);\n\nreturn [{ json: { ...cur, prev, delta_total: dTotal, delta_by_type: dType, delta_source: source } }];\n"
      },
      "id": "9cee018f-7bce-44e2-a9a4-2ea337aa108b",
      "name": "Compute Delta",
      "type": "n8n-nodes-base.code",
      "position": [
        1340,
        300
      ],
      "typeVersion": 2
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Ты аналитик open-source проекта. Напиши 3-4 предложения о неделе на русском.\n\nДанные недели ({{ $json.week_start }}): всего создано {{ $json.total_created }}, закрыто {{ $json.total_closed }}, смержено PR {{ $json.total_merged_prs }}.\nПо типам: {{ JSON.stringify($json.by_type) }}\nИзменение к прошлой неделе: {{ $json.delta_total === null ? 'нет данных' : $json.delta_total }}\nПо типам Δ: {{ JSON.stringify($json.delta_by_type) }}\nАктивные авторы: {{ $json.top_authors }}\n\nПиши по делу: что выросло, что упало, на что смотреть. Без вступлений и markdown.",
        "prompt": "=Ты аналитик open-source проекта. Напиши 3-4 предложения о неделе на русском.\n\nДанные недели ({{ $json.week_start }}): всего создано {{ $json.total_created }}, закрыто {{ $json.total_closed }}, смержено PR {{ $json.total_merged_prs }}.\nПо типам: {{ JSON.stringify($json.by_type) }}\nИзменение к прошлой неделе: {{ $json.delta_total === null ? 'нет данных' : $json.delta_total }}\nПо типам Δ: {{ JSON.stringify($json.delta_by_type) }}\nАктивные авторы: {{ $json.top_authors }}\n\nПиши по делу: что выросло, что упало, на что смотреть. Без вступлений и markdown.",
        "messages": {
          "messageValues": [
            {
              "type": "SystemMessagePromptTemplate",
              "message": "Ты краткий аналитик. Пиши по-русски, без воды."
            }
          ]
        },
        "hasOutputParser": false
      },
      "id": "6de157eb-1da1-49da-b2a1-57be5c8fbe20",
      "name": "AI Weekly Comment",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "position": [
        1560,
        300
      ],
      "typeVersion": 1.9
