      "id": "206775e0-1d1a-435d-b50c-b6f23fe85b91",
      "name": "Last Week From Data Table",
      "type": "n8n-nodes-base.dataTable",
      "position": [
        1120,
        300
      ],
      "typeVersion": 1.1,
      "alwaysOutputData": true
