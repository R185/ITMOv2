      "id": "1477774e-4875-4115-ad4a-255373e58b6e",
      "name": "PRs: merged this week",
      "type": "n8n-nodes-base.httpRequest",
      "position": [
        660,
        620
      ],
      "typeVersion": 4.5,
      "credentials": {
        "httpBearerAuth": {
          "id": "tAGP0pQBOyajAWD9",
          "name": "GitHub Bearer (R185)"
        }
      }
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "\nconst created = $('Issues: created this week').first().json;\nconst closed = $('Issues: closed this week').first().json;\nconst repoInfo = $('Repo snapshot').first().json;\nconst merged = $('PRs: merged this week').first().json;\nconst cfg = $('Week Range').first().json;\n\nconst labelsOf = (it) => (it.labels || []).map(l => typeof l === 'string' ? l : l.name);\nconst issues = created.items || [];\n\nconst byType = { bug: 0, task: 0, feature: 0, 'needs-triage': 0, other: 0 };\nconst byAuthor = {};\nconst typeOf = (it) => {\n  const ls = labelsOf(it);\n  for (const t of ['bug', 'task', 'feature', 'needs-triage']) if (ls.includes(t)) return t;\n  return 'other';\n};\n\nfor (const it of issues) {\n  byType[typeOf(it)]++;\n  const a = it.user ? it.user.login : 'unknown';\n  byAuthor[a] = (byAuthor[a] || 0) + 1;\n}\n\nconst sortedAuthors = Object.entries(byAuthor).sort((a, b) => b[1] - a[1]);\n\nreturn [{ json: {\n  week_start: cfg.week_start, prev_week_start: cfg.prev_week_start,\n  owner: cfg.owner, repo: cfg.repo, email: cfg.email,\n  total_created: issues.length,\n  total_closed: (closed.items || []).length,\n  total_merged_prs: (merged.items || []).length,\n  open_issues: repoInfo.open_issues_count ?? 0,\n  stars: repoInfo.stargazers_count ?? 0,\n  by_type: byType,\n  by_author: Object.fromEntries(sortedAuthors),\n  top_authors: sortedAuthors.slice(0, 5).map(([login, n]) => `${login} (${n})`).join(', ') || '—',\n} }];\n"
      },
