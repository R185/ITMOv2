          "temperature": 0.4
        }
      },
      "id": "081265a7-9bf7-4eec-90d5-cf80a2e52cc5",
      "name": "LLM: deepseek-flash (stats)",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "position": [
        1570,
        520
      ],
      "typeVersion": 1.3,
      "credentials": {
        "openAiApi": {
          "id": "CGPj12Jk6roAbDyu",
          "name": "VseLLM (openai-compatible)"
        }
      }
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "\nconst d = $('Compute Delta').first().json;\nconst ai = String($input.first().json.text || $input.first().json.output || '').trim();\nconst a = (v) => v === null || v === undefined ? '—' : (v > 0 ? '+' + v : String(v));\nconst color = (v) => v === null ? '#888' : v > 0 ? '#0a7' : v < 0 ? '#c33' : '#888';\n\nconst typeRows = Object.entries(d.by_type).map(([t, n]) =>\n  `<tr><td style=\"padding:4px 12px\">${t}</td><td style=\"padding:4px 12px;text-align:right\">${n}</td>\n   <td style=\"padding:4px 12px;text-align:right;color:${color(d.delta_by_type[t])}\">${a(d.delta_by_type[t])}</td></tr>`).join('');\n\nconst authorRows = Object.entries(d.by_author).map(([login, n]) =>\n  `<tr><td style=\"padding:4px 12px\">${login}</td><td style=\"padding:4px 12px;text-align:right\">${n}</td></tr>`).join('');\n\nconst subject = `Weekly stats ${d.owner}/${d.repo}: ${d.week_start}`;\nconst body = `<div style=\"font-family:system-ui,sans-serif;font-size:14px;color:#222\">\n<h2 style=\"margin:0 0 4px\">📊 Нагрузка ${d.owner}/${d.repo}</h2>\n<div style=\"color:#666\">неделя с ${d.week_start} · собрано ${new Date().toISOString().slice(0,16).replace('T',' ')} UTC</div>\n\n<table style=\"border-collapse:collapse;margin:16px 0\">\n<tr><td style=\"padding:4px 12px\">Создано issues</td><td style=\"padding:4px 12px;text-align:right\"><b>${d.total_created}</b></td>\n<td style=\"padding:4px 12px;text-align:right;color:${color(d.delta_total)}\">${a(d.delta_total)} к прошлой неделе</td></tr>\n<tr><td style=\"padding:4px 12px\">Закрыто issues</td><td style=\"padding:4px 12px;text-align:right\"><b>${d.total_closed}</b></td><td></td></tr>\n<tr><td style=\"padding:4px 12px\">Смержено PR</td><td style=\"padding:4px 12px;text-align:right\"><b>${d.total_merged_prs}</b></td><td></td></tr>\n<tr><td style=\"padding:4px 12px\">Открыто сейчас</td><td style=\"padding:4px 12px;text-align:right\"><b>${d.open_issues}</b></td><td></td></tr>\n</table>\n\n<h3>По типам</h3>\n<table style=\"border-collapse:collapse;border:1px solid #ddd\">\n<tr style=\"background:#f4f4f4\"><th style=\"padding:6px 12px;text-align:left\">Тип</th><th style=\"padding:6px 12px\">Кол-во</th><th style=\"padding:6px 12px\">Δ</th></tr>\n${typeRows}</table>\n\n<h3>По авторам</h3>\n<table style=\"border-collapse:collapse;border:1px solid #ddd\">\n<tr style=\"background:#f4f4f4\"><th style=\"padding:6px 12px;text-align:left\">Автор</th><th style=\"padding:6px 12px\">Issues</th></tr>\n${authorRows || '<tr><td colspan=\"2\" style=\"padding:6px 12px;color:#888\">нет данных</td></tr>'}</table>\n\n<h3>🤖 AI-комментарий недели</h3>\n<div style=\"background:#f8f9fb;border-left:3px solid #4a7;padding:10px 14px\">${ai || 'AI-комментарий недоступен'}</div>\n\n<div style=\"color:#999;margin-top:16px;font-size:12px\">Δ рассчитан по ${d.delta_source}; прошлая неделя: ${d.prev ? d.prev.week_start : '—'}</div>\n</div>`;\n\nreturn [{ json: { subject, html: body, email: d.email, week_start: d.week_start,\n  total: d.total_created, by_type: JSON.stringify(d.by_type), by_author: JSON.stringify(d.by_author),\n  delta_total: d.delta_total, delta_by_type: JSON.stringify(d.delta_by_type), ai_comment: ai } }];\n"
      },
