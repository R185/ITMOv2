    {
      "parameters": {
        "url": "=https://api.github.com/search/issues?q=repo:{{ $('Week Range').first().json.owner }}/{{ $('Week Range').first().json.repo }}+is:pr+merged:>={{ $('Week Range').first().json.since }}&per_page=100",
