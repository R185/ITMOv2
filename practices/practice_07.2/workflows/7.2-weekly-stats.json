    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "\nconst now = new Date();\nconst day = now.getUTCDay();                 // 0=вс\nconst monday = new Date(Date.UTC(now.getUTCFullYear(), now.getUTCMonth(), now.getUTCDate()));\nconst back = (day + 6) % 7;                  // дней назад до понедельника\nmonday.setUTCDate(monday.getUTCDate() - back);\nconst prev = new Date(monday); prev.setUTCDate(prev.getUTCDate() - 7);\nconst iso = (d) => d.toISOString().slice(0, 10);\n\nreturn [{ json: {\n  owner: $json.owner, repo: $json.repo, email: $json.email,\n  week_start: iso(monday), prev_week_start: iso(prev),\n  since: iso(monday), until: iso(new Date()) } }];\n"
      },
