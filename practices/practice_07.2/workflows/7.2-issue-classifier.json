    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "\nlet out = {};\ntry {\n  const j = $input.first().json;\n  out = j.output && typeof j.output === 'object' ? j.output : JSON.parse(String(j.text || '{}'));\n} catch (e) { out = {}; }\n\nconst allowed = ['bug', 'task', 'feature'];\nlet type = String(out.type || '').toLowerCase().trim();\nlet confidence = Number(out.confidence);\n\nif (!allowed.includes(type)) type = 'unknown';\nif (!Number.isFinite(confidence)) confidence = 0;\nif (confidence > 1) confidence = confidence / 100;\nconfidence = Math.max(0, Math.min(1, confidence));\n\nreturn [{ json: { type, confidence: Number(confidence.toFixed(2)),\n  raw_type: out.type ?? null, title: $('Prepare Issue Text').first().json.title } }];\n"
      },
