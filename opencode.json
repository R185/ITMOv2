{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "build",
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama local (practice 3)",
      "options": {
        "baseURL": "http://localhost:11434/v1"
      },
      "models": {
        "itmo-local": {
          "name": "ITMO local 4k (Modelfile)",
          "options": {
            "reasoningEffort": "none"
          },
          "limit": {
            "context": 4096,
            "output": 1024
          }
        },
        "itmo-agent": {
          "name": "ITMO local 64k (Modelfile.agent)",
          "options": {
            "reasoningEffort": "none"
          },
          "limit": {
            "context": 65536,
            "output": 4096
          }
        }
      }
    },
    "vsellm": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "VseLLM",
      "options": {
        "baseURL": "https://litellm.data-light.ru",
        "apiKey": "{env:VSELLM_API_KEY}"
      },
      "models": {
        "openai/gpt-5": {
          "name": "openai/gpt-5"
        },
        "anthropic/claude-sonnet-4": {
          "name": "anthropic/claude-sonnet-4"
        }
      }
    }
  }
}
